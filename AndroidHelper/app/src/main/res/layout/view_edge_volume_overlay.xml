<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrim to detect taps outside the panel when expanded -->
    <View
        android:id="@+id/view_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A000000"
        android:visibility="gone" />

    <!-- Expanded Volume Panel Container -->
    <LinearLayout
        android:id="@+id/ll_volume_panel"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_volume_panel"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- Panel Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.04"
                android:text="VOLUME CONTROL"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_panel_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close volume panel"
                android:padding="8dp"
                android:src="@drawable/ic_volume_close" />
        </LinearLayout>

        <!-- STREAM 1: MEDIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_media_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_volume_media"
                    android:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Media"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_media_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="0%"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/btn_media_mute"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mute media"
                    android:padding="6dp"
                    android:src="@drawable/ic_volume_mute" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressDrawable="@drawable/seek_progress_drawable"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />
        </LinearLayout>

        <!-- STREAM 2: RING & NOTIFICATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_ring_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_volume_ring"
                    android:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Ring &amp; Alerts"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ring_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressDrawable="@drawable/seek_progress_drawable"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />
        </LinearLayout>

        <!-- STREAM 3: ALARM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_alarm_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_volume_alarm"
                    android:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Alarm"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_alarm_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressDrawable="@drawable/seek_progress_drawable"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />
        </LinearLayout>

    </LinearLayout>

    <!-- Collapsed Handle Container (Flush with right edge) -->
    <!-- Large touch target container (36dp x 84dp), with narrow visible pill inside (6dp x 52dp) -->
    <FrameLayout
        android:id="@+id/fl_handle_container"
        android:layout_width="36dp"
        android:layout_height="84dp"
        android:layout_gravity="end|top">

        <View
            android:id="@+id/v_handle_pill"
            android:layout_width="6dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_volume_handle" />

    </FrameLayout>

</FrameLayout>
