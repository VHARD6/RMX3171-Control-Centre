<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- App Icon -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_broom" />

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- App Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Dual-Tier System &amp; App Cache Cleaner"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ================================================================= -->
        <!-- TIER 1: QUICK CLEAN ALL (Shizuku System Trim)                     -->
        <!-- ================================================================= -->
        <LinearLayout
            android:id="@+id/ll_quick_clean_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Card Header / Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/tier1_badge"
                android:textColor="@color/accent_badge"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tier1_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/tier1_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Shizuku Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@color/bg_main"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shizuku Privilege Bridge:"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_quick_shizuku_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="CHECKING..."
                    android:textColor="@color/accent_badge"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_quick_shizuku_action"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_secondary_background"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Setup / Authorize Shizuku"
                android:textAllCaps="false"
                android:textColor="@color/accent_badge"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Primary Quick Clean Button -->
            <Button
                android:id="@+id/btn_quick_clean_all"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_primary_background"
                android:elevation="0dp"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                android:text="@string/btn_quick_clean_all"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Quick Clean Result Container (Shown after execution) -->
            <LinearLayout
                android:id="@+id/ll_quick_clean_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/bg_main"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_quick_clean_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="QUICK CLEAN COMPLETED"
                    android:textColor="@color/accent_badge"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_quick_storage_before"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_quick_storage_after"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_quick_storage_reclaimed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_quick_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_card" />

                <TextView
                    android:id="@+id/tv_quick_scope_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Trimmed quota-managed Android system and download caches. Individual private app caches are unaffected and require Tier 2 Deep Clean."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================================= -->
        <!-- TIER 2: DEEP CLEAN APPS (Targeted Accessibility Cleaner)          -->
        <!-- ================================================================= -->
        <LinearLayout
            android:id="@+id/ll_tier2_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/tier2_badge"
                android:textColor="@color/accent_badge"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tier2_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/tier2_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Accessibility Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@color/bg_main"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Accessibility Probe Service:"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tier2_a11y_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="ACTIVE"
                    android:textColor="@color/accent_badge"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_tier2_open_a11y"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_secondary_background"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Enable in Accessibility Settings"
                android:textAllCaps="false"
                android:textColor="@color/accent_badge"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Open Multi-App Cleaner Button -->
            <Button
                android:id="@+id/btn_open_multiapp_cleaner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_primary_background"
                android:elevation="0dp"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                android:text="@string/btn_open_app_cleaner"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ================================================================= -->
        <!-- ADVANCED DIAGNOSTICS & SINGLE-APP PILOT (Collapsed / Advanced)    -->
        <!-- ================================================================= -->
        <LinearLayout
            android:id="@+id/ll_pilot_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="DIAGNOSTIC TEST — SINGLE-APP PILOT"
                android:textColor="@color/accent_badge"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:text="Runs an isolated test of guarded cache cleaning on Instagram only to verify Settings UI automation."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_test_pilot_instagram"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_secondary_background"
                android:elevation="0dp"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                android:text="@string/pilot_btn_title"
                android:textAllCaps="false"
                android:textColor="@color/accent_badge"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Pilot Outcome Container -->
            <LinearLayout
                android:id="@+id/ll_pilot_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bg_main"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_pilot_outcome_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/pilot_outcome_title"
                    android:textColor="@color/accent_badge"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_pilot_outcome_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_pilot_cache_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Secondary Action: App Info -->
        <Button
            android:id="@+id/btn_app_info"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_secondary_background"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_app_info"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Footer Note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Dual-tier cleaner • Safe Android 11 / ColorOS 11 cache operations"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
