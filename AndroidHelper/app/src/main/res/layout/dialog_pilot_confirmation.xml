<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="FINAL CONFIRMATION • STEP 2"
        android:textColor="@color/accent_badge"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Clear Instagram Private Cache?"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Observed Cache Information Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@color/bg_main"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_dialog_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target: com.instagram.android"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_dialog_cache_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Observed Cache: Calculating..."
            android:textColor="@color/accent_badge"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Verified Screen: ColorOS Storage usage"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Safeguard Verification List -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="3dp"
        android:text="✓ Exact 'Clear cache' button isolated\n✓ 'Clear data' button protected (will NOT be clicked)\n✓ Accounts, logins and messages remain intact"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary_background"
            android:elevation="0dp"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null"
            android:text="CANCEL"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dialog_proceed"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary_background"
            android:elevation="0dp"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null"
            android:text="CLEAR CACHE"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
