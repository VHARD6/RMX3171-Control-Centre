<UserControl x:Class="RMX3171ControlCentre.Views.MemoryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Memory &amp; Tasks" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh Now" Command="{Binding RefreshCommand}" Margin="20,0,0,0" Padding="15,6" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" VerticalAlignment="Center" IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
            <TextBlock Text="Refreshing..." Foreground="Orange" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
            <TextBlock Text="{Binding LastUpdatedText}" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Educational / Safety Banner -->
        <Border Grid.Row="1" Background="#2A2A1A" BorderBrush="#8A7A20" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <TextBlock TextWrapping="Wrap" Foreground="#F0E68C" FontSize="13">
                <Run FontWeight="Bold">Notice:</Run>
                <Run>Android manages memory automatically. Closing apps can help when a specific application is misbehaving or consuming unusually high memory. Core system components and critical services are protected to prevent device instability.</Run>
            </TextBlock>
        </Border>

        <!-- Memory Dashboard Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Physical RAM -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="PHYSICAL RAM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="{Binding CurrentMemoryInfo.UsedGB, StringFormat={}{0:F2}}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" GB used / " FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentMemoryInfo.TotalGB, StringFormat={}{0:F1}}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        <TextBlock Text=" GB" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0">
                        <Run Text="Available: " />
                        <Run Text="{Binding CurrentMemoryInfo.AvailableGB, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="White" />
                        <Run Text=" GB  (Cached: " />
                        <Run Text="{Binding CurrentMemoryInfo.CachedGB, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="White" />
                        <Run Text=" GB)" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ZRAM / Swap -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="ZRAM (SWAP COMPRESSION)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="{Binding CurrentMemoryInfo.ZramUsedGB, StringFormat={}{0:F2}}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" GB used / " FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentMemoryInfo.ZramTotalGB, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        <TextBlock Text=" GB" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Compressed kernel memory pool" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Memory Pressure -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="MEMORY PRESSURE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CurrentMemoryInfo.MemoryPressure}" FontSize="22" FontWeight="Bold" Foreground="#4EC9B0" Margin="0,0,0,5"/>
                    <TextBlock Text="Real-time kernel state" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top RAM Consumers Table -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="TOP CONSUMING APPLICATIONS (> 10 MB)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding TopConsumers}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#262629" GridLinesVisibility="None"
                          Foreground="White">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#333337"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#444448"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Package Name" Binding="{Binding PackageName}" Width="2*" />
                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamMb, StringFormat={}{0:F1}}" Width="*" />
                        <DataGridTemplateColumn Header="Action" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Close App" 
                                            Command="{Binding DataContext.ForceStopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Padding="10,3" Margin="2" Background="#C23934" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                        <Setter Property="Content" Value="Protected" />
                                                        <Setter Property="Background" Value="#444448" />
                                                        <Setter Property="Foreground" Value="#888888" />
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
