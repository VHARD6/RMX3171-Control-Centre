<UserControl x:Class="RMX3171ControlCentre.Views.MemoryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Memory Manager" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Scan Memory" Command="{Binding RefreshCommand}" Margin="20,0,0,0" Padding="15,6"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" VerticalAlignment="Center"
                    IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
            <TextBlock Text="Scanning..." Foreground="Orange" VerticalAlignment="Center" Margin="10,0,0,0"
                       Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
            <TextBlock Text="{Binding LastUpdatedText}" Foreground="Gray" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Educational Banner -->
        <Border Grid.Row="1" Background="#2A2A1A" BorderBrush="#8A7A20" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <TextBlock TextWrapping="Wrap" Foreground="#F0E68C" FontSize="12">
                <Run FontWeight="Bold">Notice:</Run>
                <Run>Android uses RAM for apps, caching, and system services. Memory pressure and heavy background apps are better indicators than free RAM alone.</Run>
                <LineBreak/>
                <Run FontWeight="Bold">PSS (Proportional Set Size)</Run>
                <Run>is used — it accounts for shared memory proportionally. Numbers shown are per-app estimates. They do not add up to exactly total RAM used.</Run>
            </TextBlock>
        </Border>

        <!-- RAM Summary Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- RAM -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RAM USAGE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentMemoryInfo.UsedGB, StringFormat={}{0:F2}}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text=" / " FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentMemoryInfo.TotalGB, StringFormat={}{0:F1}}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            <TextBlock Text=" GB" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding CurrentMemoryInfo.UsedGB}" Maximum="{Binding CurrentMemoryInfo.TotalGB}"
                                     Height="4" Margin="0,5,15,5" BorderThickness="0" Background="#333333" Foreground="#4EC9B0"/>
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12">
                            <Run Text="Available: "/>
                            <Run Text="{Binding CurrentMemoryInfo.AvailableGB, StringFormat={}{0:F2} GB}" FontWeight="Bold" Foreground="White"/>
                            <Run Text="   Cached: "/>
                            <Run Text="{Binding CurrentMemoryInfo.CachedGB, StringFormat={}{0:F2} GB}" FontWeight="Bold" Foreground="White"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="USER APPS" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock Text="{Binding UserAppsTotalLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#4EC9B0" Margin="0,2,0,8"/>
                        <TextBlock Text="VENDOR / SYSTEM" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock Text="{Binding SystemTotalLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#FF888888" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ZRAM -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="ZRAM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentMemoryInfo.ZramUsedGB, StringFormat={}{0:F2}}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentMemoryInfo.ZramTotalGB, StringFormat={}{0:F2}}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        <TextBlock Text=" GB" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Compresses RAM pages. Not a problem." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Memory Pressure -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="MEMORY PRESSURE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding CurrentMemoryInfo.MemoryPressure}" FontSize="20" FontWeight="Bold" Foreground="#4EC9B0"/>
                    <TextBlock Text="From Android kernel status" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cleanup History -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="LAST CLEANUP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding LastCleanupSummary}" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Bd" Padding="14,8" Margin="0,0,8,0"
                                        BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="TextElement.Foreground" Value="White"/>
                                        <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 1 — USER APPS                                                -->
            <!-- ══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="USER APPLICATIONS">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center">
                                <Run Text="Normal user-installed applications."/>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Quick Clean" Command="{Binding QuickCleanCommand}"
                                        Background="#007ACC" Foreground="White" BorderThickness="0"
                                        Padding="15,6" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <Button Content="Clean Selected" Command="{Binding CleanSelectedCommand}"
                                        Background="#C23934" Foreground="White" BorderThickness="0"
                                        Padding="15,6" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding UserAppProcesses}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#262629"
                                  GridLinesVisibility="None" Foreground="White" CanUserSortColumns="True">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333337"/>
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#444448"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanForceStop}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Package Name" Binding="{Binding PackageName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="RAM — PSS" Binding="{Binding RamMb, StringFormat={}{0:F0} MB}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="State" Binding="{Binding Importance}" Width="110" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Recommendation" Width="180" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RecommendationString}" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                                                <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Action" Width="110" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ForceStopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,3" Margin="2" BorderThickness="0" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Force Stop"/>
                                                        <Setter Property="Background" Value="#444448"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanForceStop}" Value="False">
                                                                <Setter Property="Content" Value="🔒 Protected"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 2 — VENDOR OPTIONAL                                          -->
            <!-- ══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="VENDOR OPTIONAL">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1A2A3A" BorderBrush="#204060" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" Foreground="#A0C0E0" FontSize="12">
                                <Run FontWeight="Bold">ℹ VENDOR COMPONENTS.</Run>
                                <Run>These are vendor/OEM processes. Some may be optional. Requires Expert Actions to modify.</Run>
                            </TextBlock>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding VendorOptionalProcesses}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#262629"
                                  GridLinesVisibility="None" Foreground="White" CanUserSortColumns="True">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333337"/>
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#444448"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanForceStop}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Package Name" Binding="{Binding PackageName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="RAM — PSS" Binding="{Binding RamMb, StringFormat={}{0:F0} MB}" Width="100" IsReadOnly="True"/>
                                
                                <DataGridTemplateColumn Header="Recommendation" Width="200" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RecommendationString}" FontWeight="SemiBold" Foreground="#E0D050"/>
                                                <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Action" Width="110" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ForceStopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,3" Margin="2" BorderThickness="0" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Force Stop"/>
                                                        <Setter Property="Background" Value="#444448"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanForceStop}" Value="False">
                                                                <Setter Property="Content" Value="🔒 Protected"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 3 — SYSTEM / CRITICAL                                        -->
            <!-- ══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="SYSTEM / CRITICAL">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Warning banner -->
                        <Border Grid.Row="0" Background="#2A1A1A" BorderBrush="#8A3020" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" Foreground="#FFA07A" FontSize="12">
                                <Run Text="System and vendor components are shown for diagnostic purposes."/>
                                <Run Text=" Critical Android components remain protected."/>
                                <LineBreak/>
                                <Run Text="Data sources: "/>
                                <Run Text="{Binding DataSources}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SystemProcesses}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#262629"
                                  GridLinesVisibility="None" Foreground="#FFBBBBBB" CanUserSortColumns="True">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333337"/>
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#444448"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanForceStop}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Process / Package" Binding="{Binding PackageName}" Width="*"/>
                                <DataGridTextColumn Header="RAM" Binding="{Binding RamMb, StringFormat={}{0:F0} MB}" Width="70"/>
                                
                                <DataGridTemplateColumn Header="Recommendation" Width="200" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RecommendationString}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFA07A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FF6060"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="#888888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="Action" Width="110" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ForceStopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,3" Margin="2" BorderThickness="0" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Force Stop"/>
                                                        <Setter Property="Background" Value="#444448"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanForceStop}" Value="False">
                                                                <Setter Property="Content" Value="🔒 Protected"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
