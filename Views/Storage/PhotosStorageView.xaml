<UserControl x:Class="RMX3171ControlCentre.Views.Storage.PhotosStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sub-page Header & Storage Summary -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Command="{Binding GoBackCommand}" Content="← Back to Storage"
                    Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                    BorderThickness="0" HorizontalAlignment="Left" Padding="0,0,0,10" FontSize="14"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,5,0,0">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title, Big Size, Count, Status -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PHOTO STORAGE" FontSize="14" FontWeight="Bold" Foreground="#FF888888"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding TotalStorageSummaryText}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding TotalPhotosCountText}" FontSize="16" Foreground="#FFAAAAAA" VerticalAlignment="Bottom" Margin="14,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ScanStatusText}" Foreground="#FF888888" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Right: Scan Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Scan Again" Command="{Binding ScanPhotosCommand}"
                                Padding="15,8" Background="{StaticResource PrimaryBrush}" Foreground="White"
                                BorderThickness="0" Margin="0,0,10,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                        <Button Content="Cancel Scan" Command="{Binding CancelScanCommand}"
                                Padding="15,8" Background="#FFCC3333" Foreground="White" BorderThickness="0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Loading / scanning overlay -->
            <Border Background="{StaticResource BackgroundBrush}"
                    Visibility="{Binding IsLoaded, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsScanning}" Value="0"
                                 Width="200" Height="4"
                                 Foreground="{StaticResource PrimaryBrush}" Background="#FF333333"
                                 BorderThickness="0" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding ScanStatusText}" Foreground="White" FontSize="16"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ═════════ VIEW 1: FOLDER GROUPS VIEW ═════════ -->
            <Grid Visibility="{Binding IsFolderView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar for Folders -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search photo folders..." Padding="8,6"
                             Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>

                    <TextBlock Grid.Column="1" Text="{Binding FolderGroups.Count, StringFormat='{}{0} folders discovered'}"
                               Foreground="#FF888888" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                </Grid>

                <!-- Virtualized / Scrollable List of Discovered Folder Groups -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FolderGroupsView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12"
                                        Cursor="Hand">
                                    <Border Style="{StaticResource CardStyle}" Width="250" Height="110" Background="#FF28282B"
                                            Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Folder Name -->
                                            <TextBlock Grid.Row="0" Text="{Binding FolderName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>

                                            <!-- Count & Size -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                                                <TextBlock Text="{Binding PhotoCountText}" FontSize="13" Foreground="#FFAAAAAA"/>
                                                <TextBlock Text="  •  " FontSize="13" Foreground="#FF555555"/>
                                                <TextBlock Text="{Binding TotalSizeText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            </StackPanel>

                                            <!-- Sample Path hint -->
                                            <TextBlock Grid.Row="2" Text="{Binding SamplePath}" FontSize="11" Foreground="#FF666666"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ═════════ VIEW 2: FOLDER DRILLDOWN / PHOTO LIST ═════════ -->
            <Grid Visibility="{Binding IsFolderView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Breadcrumb & Back to Folders Button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding BackToFoldersCommand}" Content="← Back to Folders"
                            Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                            BorderThickness="0" Padding="0,0,16,0" FontSize="13" FontWeight="SemiBold"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentBreadcrumb}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="  •  " Foreground="#FF555555" FontSize="14"/>
                        <TextBlock Text="{Binding SelectedFolderSummaryText}" Foreground="#FFAAAAAA" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Search & Sort Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search photos by name or path..." Padding="8,6"
                             Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                              Padding="8,6" Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>
                </Grid>

                <!-- Main Layout: Virtualized Table + GridSplitter + Right Details Panel -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- Table takes all available space -->
                        <ColumnDefinition Width="*" MinWidth="320"/>
                        <!-- Drag Handle -->
                        <ColumnDefinition Width="5"/>
                        <!-- Details Panel -->
                        <ColumnDefinition Width="280" MinWidth="0" MaxWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- Virtualized DataGrid -->
                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding FolderPhotosView}" SelectedItem="{Binding SelectedPhoto}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Background="{StaticResource CardBrush}" BorderThickness="0"
                              RowBackground="Transparent" AlternatingRowBackground="#FF222225"
                              GridLinesVisibility="None" Foreground="White"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF333337"/>
                                <Setter Property="Foreground" Value="#FFAAAAAA"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="SeparatorBrush" Value="#FF555558"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF005599"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="32"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- File Name -->
                            <DataGridTextColumn Header="File name" Binding="{Binding FileName}"
                                                Width="1.8*" MinWidth="140" CanUserResize="True"/>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}"
                                                Width="SizeToHeader" MinWidth="80" CanUserResize="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Date Modified -->
                            <DataGridTextColumn Header="Date" Binding="{Binding DateModifiedText}"
                                                Width="130" MinWidth="110" CanUserResize="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFAAAAAA"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Path -->
                            <DataGridTextColumn Header="Path" Binding="{Binding FullPath}"
                                                Width="2.2*" MinWidth="160" CanUserResize="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF888888"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Draggable divider -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="#FF3A3A3D" Cursor="SizeWE"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Right Details Panel -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <!-- Empty State Hint -->
                            <TextBlock Text="Select a photo to view details."
                                       Foreground="#FF888888" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                       Visibility="{Binding HasSelectedPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                            <!-- Details Content -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasSelectedPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Margin="14">
                                    <TextBlock Text="{Binding SelectedPhoto.FileName}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="White"
                                               Margin="0,0,0,6" TextWrapping="Wrap"/>

                                    <Border Background="#FF333337" CornerRadius="4" Padding="7,3"
                                            HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding SelectedPhoto.Folder}" Foreground="White" FontSize="12"/>
                                    </Border>

                                    <!-- Size -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Size:" Foreground="#FFAAAAAA" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedPhoto.SizeText}"
                                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    </Grid>

                                    <!-- Date Modified -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date modified:" Foreground="#FFAAAAAA" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedPhoto.DateModifiedText}"
                                                   Foreground="White" FontSize="13"/>
                                    </Grid>

                                    <!-- MIME Type -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="MIME type:" Foreground="#FFAAAAAA" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedPhoto.MimeType}"
                                                   Foreground="White" FontSize="13"/>
                                    </Grid>

                                    <!-- Extension -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Extension:" Foreground="#FFAAAAAA" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedPhoto.Extension}"
                                                   Foreground="White" FontSize="13"/>
                                    </Grid>

                                    <Border Height="1" Background="#FF444444" Margin="0,8,0,14"/>

                                    <!-- Full Path -->
                                    <TextBlock Text="Full Path:" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedPhoto.FullPath, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             Background="#FF1E1E20" Foreground="#FFAAAAAA"
                                             BorderThickness="0" Padding="6,6" FontSize="11"/>

                                    <!-- Read-Only Notice -->
                                    <TextBlock Text="Read-Only Mode: Deletion and modification are disabled."
                                               Foreground="#FF666666" FontSize="11" Margin="0,18,0,0" FontStyle="Italic"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
