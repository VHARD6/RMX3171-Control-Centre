<UserControl x:Class="RMX3171ControlCentre.Views.Storage.PhotosStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Background/Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sub-page Header & Storage Summary -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Button Command="{Binding GoBackCommand}" Content="← Back to Storage"
                        Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" HorizontalAlignment="Left" Padding="0,0,0,10" FontSize="14"/>

                <Border Style="{StaticResource CardStyle}" Margin="0,5,0,0">
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PHOTO STORAGE" FontSize="14" FontWeight="Bold" Foreground="#FF888888"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TotalStorageSummaryText}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding TotalPhotosCountText}" FontSize="16" Foreground="#FFAAAAAA" VerticalAlignment="Bottom" Margin="14,0,0,3"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ScanStatusText}" Foreground="#FF888888" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Global Filter Combobox -->
                            <ComboBox Margin="0,0,15,0" Width="150"
                                      ItemsSource="{Binding StorageFilters}"
                                      SelectedItem="{Binding SelectedStorageFilter}"
                                      Padding="8,6" Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"
                                      Visibility="{Binding IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                            <Button Content="Scan Again" Command="{Binding ScanPhotosCommand}"
                                    Padding="15,8" Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,10,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                            <Button Content="Cancel Scan" Command="{Binding CancelScanCommand}"
                                    Padding="15,8" Background="#FFCC3333" Foreground="White" BorderThickness="0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <!-- Loading overlay -->
                <Border Background="{StaticResource BackgroundBrush}"
                        Visibility="{Binding IsLoaded, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="{Binding IsScanning}" Value="0"
                                     Width="200" Height="4"
                                     Foreground="{StaticResource PrimaryBrush}" Background="#FF333333"
                                     BorderThickness="0" Margin="0,0,0,15"/>
                        <TextBlock Text="{Binding ScanStatusText}" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ═════════ VIEW 1: FOLDER GROUPS VIEW ═════════ -->
                <Grid Visibility="{Binding IsFolderView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search photo folders..." Padding="8,6"
                                 Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>

                        <TextBlock Grid.Column="1" Text="{Binding FolderGroupsView.Count, StringFormat='{}{0} folders discovered'}"
                                   Foreground="#FF888888" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FolderGroupsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12"
                                            Cursor="Hand">
                                        <Border Style="{StaticResource CardStyle}" Width="250" Height="110" Background="#FF28282B"
                                                Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FolderName}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Row="0" Grid.Column="1" Background="#FF444444" CornerRadius="4" Padding="4,2" Margin="5,0,0,0">
                                                    <TextBlock Text="{Binding LocationLabel}" FontSize="10" Foreground="#FFCCCCCC"/>
                                                </Border>

                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                                                    <TextBlock Text="{Binding PhotoCountText}" FontSize="13" Foreground="#FFAAAAAA"/>
                                                    <TextBlock Text="  •  " FontSize="13" Foreground="#FF555555"/>
                                                    <TextBlock Text="{Binding TotalSizeText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SamplePath}" FontSize="11" Foreground="#FF666666"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ═════════ VIEW 2: FOLDER DRILLDOWN / PHOTO BROWSER ═════════ -->
                <Grid Visibility="{Binding IsFolderView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding BackToFoldersCommand}" Content="← Folders"
                                Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                                BorderThickness="0" Padding="0,0,16,0" FontSize="13" FontWeight="SemiBold"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentBreadcrumb}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="  •  " Foreground="#FF555555" FontSize="14"/>
                            <TextBlock Text="{Binding SelectedFolderSummaryText}" Foreground="#FFAAAAAA" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search photos by name..." Padding="8,6"
                                 Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="Grid" Command="{Binding ShowGridViewCommand}"
                                    Padding="10,5" Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,5,0"
                                    Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <Border Background="#FF555555" Padding="10,5" Margin="0,0,5,0"
                                    Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Grid" Foreground="White" FontWeight="Bold"/>
                            </Border>

                            <Button Content="List" Command="{Binding ShowListViewCommand}"
                                    Padding="10,5" Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    BorderThickness="0"
                                    Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Border Background="#FF555555" Padding="10,5"
                                    Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="List" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                  Padding="8,6" Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>
                    </Grid>

                    <!-- TRUE VIRTUALIZED GRID OR LIST SWITCH -->
                    <Grid Grid.Row="2" SizeChanged="GridContainer_SizeChanged">
                        
                        <!-- GRID VIEW: Virtualized Row Grouping -->
                        <ListBox x:Name="PhotoGridBox" 
                                 ItemsSource="{Binding GridRows}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RowItemStyle}"
                                 Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- The Photo Card -->
                                                <Border Width="180" Height="210" Margin="4" Padding="4" CornerRadius="4"
                                                        MouseLeftButtonDown="PhotoCard_MouseLeftButtonDown"
                                                        MouseLeftButtonUp="PhotoCard_MouseLeftButtonUp"
                                                        Loaded="PhotoCard_Loaded" Unloaded="PhotoCard_Unloaded">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#330078D7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    
                                                    <Grid Background="Transparent"> <!-- For Hit Testing -->
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="165"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Background="#FF1E1E20" CornerRadius="4" ClipToBounds="True">
                                                            <Grid>
                                                                <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 Z M 11 19.93 C 7.05 19.43 4 16.05 4 12 C 4 7.95 7.05 4.57 11 4.07 V 19.93 Z M 13 4.07 C 16.95 4.57 20 7.95 20 12 C 20 16.05 16.95 19.43 13 19.93 V 4.07 Z"
                                                                      Fill="#FF444444" Stretch="Uniform" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                
                                                                <Border Background="#99000000" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="3,1">
                                                                    <TextBlock Text="{Binding StorageSourceLabel}" Foreground="White" FontSize="9"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Row="1" Margin="2,4,2,0">
                                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <Grid>
                                                                <TextBlock Text="{Binding DateModifiedText}" Foreground="#FF888888" FontSize="10" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- LIST VIEW -->
                        <DataGrid x:Name="PhotoDataGrid"
                                  ItemsSource="{Binding FolderPhotosView}" SelectedItem="{Binding SelectedPhoto}"
                                  Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  SelectionChanged="PhotoDataGrid_SelectionChanged"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Background="{StaticResource CardBrush}" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#FF222225"
                                  GridLinesVisibility="None" Foreground="White"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FF333337"/>
                                    <Setter Property="Foreground" Value="#FFAAAAAA"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="SeparatorBrush" Value="#FF555558"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF005599"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="32"/>
                                    <!-- Double click support in list view -->
                                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File name" Binding="{Binding FileName}" Width="2*" MinWidth="140"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding StorageSourceLabel}" Width="1*" MinWidth="80"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="SizeToHeader" MinWidth="80"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateModifiedText}" Width="130" MinWidth="110"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FF888888"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Row="3" Background="#FF1E1E20" BorderBrush="#FF333333" BorderThickness="0,1,0,0" Padding="12,6" Margin="0,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FolderPhotosView.Count, StringFormat='{}{0:N0} items'}" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectionSummaryText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═════════ VIEWER OVERLAY ═════════ -->
        <Grid x:Name="ViewerOverlay" Panel.ZIndex="100" 
              Visibility="{Binding ViewerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#EF000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Viewer Header -->
            <Grid Grid.Row="0" Background="#99000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding ViewerPhoto.FileName}" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  " FontSize="16" Foreground="#FF555555" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ViewerPhoto.SizeText}" FontSize="14" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  " FontSize="16" Foreground="#FF555555" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ViewerPhoto.DateModifiedText}" FontSize="14" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  " FontSize="16" Foreground="#FF555555" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ViewerPhoto.StorageSourceLabel}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕ Close (Esc)" Command="{Binding CloseViewerCommand}"
                        Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Padding="20,0"/>
            </Grid>

            <!-- Viewer Main Area -->
            <Grid Grid.Row="1">
                <!-- Loading text -->
                <TextBlock Text="Loading image..." Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ViewerIsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <ScrollViewer x:Name="ViewerScrollViewer" 
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="Transparent" Focusable="False"
                              PreviewMouseWheel="ViewerScrollViewer_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="ViewerScrollViewer_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="ViewerScrollViewer_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="ViewerScrollViewer_PreviewMouseMove"
                              SizeChanged="ViewerScrollViewer_SizeChanged">
                    <Grid x:Name="ViewerImageContainer"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image x:Name="ViewerImage" 
                               Source="{Binding ViewerImageSource}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="Uniform" />
                    </Grid>
                </ScrollViewer>

                <!-- Navigation Buttons (Overlay) -->
                <Button Content="‹" Command="{Binding PrevViewerPhotoCommand}" 
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                        Width="50" Height="80" FontSize="36" Background="#44000000" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="›" Command="{Binding NextViewerPhotoCommand}" 
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Width="50" Height="80" FontSize="36" Background="#44000000" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <!-- Viewer Bottom Bar (Controls) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#99000000">
                <Button Content="-" Command="{Binding ZoomOutViewerCommand}" Click="ZoomOutButton_Click" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" Cursor="Hand"/>
                <Button Content="Fit" Command="{Binding FitViewerCommand}" Click="FitButton_Click" Padding="15,0" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="100%" Command="{Binding ActualSizeViewerCommand}" Click="ActualSizeButton_Click" Padding="15,0" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="+" Command="{Binding ZoomInViewerCommand}" Click="ZoomInButton_Click" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
