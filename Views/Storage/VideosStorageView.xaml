<UserControl x:Class="RMX3171ControlCentre.Views.Storage.VideosStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Command="{Binding GoBackCommand}" Content="← Back to Storage"
                    Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                    BorderThickness="0" HorizontalAlignment="Left" Padding="0,0,0,10" FontSize="14"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,5,0,0">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VIDEO STORAGE" FontSize="14" FontWeight="Bold" Foreground="#FF888888"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding TotalStorageSummaryText}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding TotalVideosCountText}" FontSize="16" Foreground="#FFAAAAAA" VerticalAlignment="Bottom" Margin="14,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ScanStatusText}" Foreground="#FF888888" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Margin="0,0,15,0" Width="150"
                                  ItemsSource="{Binding StorageFilters}"
                                  SelectedItem="{Binding SelectedStorageFilter}"
                                  Padding="8,6" Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"
                                  Visibility="{Binding IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                        <Button Content="Scan Again" Command="{Binding ScanVideosCommand}"
                                Padding="15,8" Background="{StaticResource PrimaryBrush}" Foreground="White"
                                BorderThickness="0" Margin="0,0,10,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                        <Button Content="Cancel Scan" Command="{Binding CancelScanCommand}"
                                Padding="15,8" Background="#FFCC3333" Foreground="White" BorderThickness="0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Main Area -->
        <Grid Grid.Row="1">
            <Border Background="{StaticResource BackgroundBrush}"
                    Visibility="{Binding IsLoaded, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsScanning}" Value="0"
                                 Width="200" Height="4"
                                 Foreground="{StaticResource PrimaryBrush}" Background="#FF333333"
                                 BorderThickness="0" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding ScanStatusText}" Foreground="White" FontSize="16"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- FOLDER GROUPS VIEW -->
            <Grid Visibility="{Binding IsFolderView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentBreadcrumb}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Tag="Search folders..." 
                             Padding="8,6" Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"
                             VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FolderGroupsView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="-5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="5" Padding="0" BorderThickness="0" Background="Transparent"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Cursor="Hand" Width="200" Height="200">
                                    <Border Background="#FF1E1E20" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Background="#FF121214">
                                                <TextBlock Text="📁" FontSize="64" Foreground="{StaticResource PrimaryBrush}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20"/>
                                                <Border Background="#99000000" VerticalAlignment="Bottom" Padding="5,2" HorizontalAlignment="Right" Margin="5">
                                                    <TextBlock Text="{Binding LocationLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <Border Grid.Row="1" Background="#FF1E1E20" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FolderName}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding VideoCountText}" Foreground="#FFAAAAAA" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding TotalSizeText}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- FOLDER VIDEOS VIEW -->
            <Grid Visibility="{Binding IsFolderView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Command="{Binding BackToFoldersCommand}" 
                            Content="â€¹ Folders" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Padding="0,0,15,0"/>
                    
                    <TextBlock Grid.Column="1" Text="{Binding CurrentBreadcrumb}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding SelectedFolderSummaryText}" Foreground="#FFAAAAAA" FontSize="14" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Sort by:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                  Padding="8,4" Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>
                    </StackPanel>
                    
                    <TextBox Grid.Column="2" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Tag="Search videos..." Width="200" VerticalAlignment="Center" Margin="0,0,15,0"
                             Padding="8,6" Background="#FF2A2A2E" Foreground="White" BorderBrush="#FF444444"/>
                             
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Command="{Binding ShowGridViewCommand}" Padding="8,4" BorderThickness="1" 
                                BorderBrush="{StaticResource PrimaryBrush}" Content="Grid"
                                Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Command="{Binding ShowListViewCommand}" Padding="8,4" BorderThickness="1" Margin="-1,0,0,0"
                                BorderBrush="{StaticResource PrimaryBrush}" Content="List"
                                Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Virtualized Grid View -->
                <Grid Grid.Row="2" SizeChanged="VideosVirtualListBox_SizeChanged" Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox x:Name="VideosVirtualListBox"
                             ItemsSource="{Binding GridRows}"
                             ItemContainerStyle="{StaticResource RowItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="1,1"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             SelectionMode="Extended">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- The row container -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="VideoCard"
                                                    Width="200" Height="200"
                                                    Margin="4" Padding="0" BorderThickness="2"
                                                    Background="#FF1E1E20" CornerRadius="4"
                                                    Cursor="Hand"
                                                    PreviewMouseLeftButtonDown="VideoCard_MouseLeftButtonDown"
                                                    Loaded="VideoCard_Loaded"
                                                    Unloaded="VideoCard_Unloaded">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#FF333333"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                                <Setter Property="Background" Value="#FF2A2A3A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="140"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0" Background="#FF121214" ClipToBounds="True">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Duration overlay positioned over row 0 -->
                                                    <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#99000000" Padding="4,2" Margin="4" IsHitTestVisible="False">
                                                        <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    
                                                    <Border Grid.Row="1" Background="#EE1E1E20" Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                                <TextBlock Text=" â€¢ " Foreground="#FF555555" FontSize="11"/>
                                                                <TextBlock Text="{Binding Resolution}" Foreground="#FFAAAAAA" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- DataGrid List View -->
                <Grid Grid.Row="2" Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding FolderVideosView}" 
                              AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="#FF1E1E20"
                              AlternatingRowBackground="#FF1A1A1C"
                              HorizontalGridLinesBrush="#FF333333"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectedItem="{Binding SelectedVideo}"
                              SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF121214"/>
                                <Setter Property="Foreground" Value="#FFAAAAAA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#FF333333"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="MinHeight" Value="32"/>
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF2A2A3A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF252528"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File name" Binding="{Binding FileName}" Width="2*" MinWidth="140"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding StorageSourceLabel}" Width="1*" MinWidth="80"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="1*" MinWidth="80"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="SizeToHeader" MinWidth="80"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateModifiedText}" Width="130" MinWidth="110"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*" MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FF888888"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border Grid.Row="3" Background="#FF1E1E20" BorderBrush="#FF333333" BorderThickness="0,1,0,0" Padding="12,6" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FolderVideosView.Count, StringFormat='{}{0:N0} items'}" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectionSummaryText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Viewer Overlay -->
        <Grid x:Name="ViewerOverlay" Grid.RowSpan="2" Visibility="{Binding ViewerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100" Background="#DD000000">
            <!-- Loading Indicator -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Visibility="{Binding ViewerIsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,15" Foreground="{StaticResource PrimaryBrush}" Background="#FF333333" BorderThickness="0"/>
                <TextBlock Text="{Binding ViewerLoadingText}" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Player layout: rows = [top pad] [video area *] [controls bar Auto] [bottom pad] -->
            <Grid Visibility="{Binding ViewerIsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                <!-- Video area: fills remaining height, MediaElement is constrained by this row -->
                <Grid Grid.Row="1" x:Name="VideoPlayerWrapper">
                    <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Player Controls always visible below the video -->
                <Border Grid.Row="2" Background="#EE1E1E20" CornerRadius="8" Padding="15,10"
                        HorizontalAlignment="Center" Width="600" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="PlayPauseButton" Grid.Column="0" Content="⏸" FontSize="18" Padding="10,5" Margin="0,0,10,0" 
                                Background="#FF333333" Foreground="White" BorderThickness="0" Click="PlayPauseButton_Click" Cursor="Hand"/>
                        
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        
                        <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1" 
                                Thumb.DragStarted="SeekSlider_DragStarted" Thumb.DragCompleted="SeekSlider_DragCompleted" ValueChanged="SeekSlider_ValueChanged"
                                IsMoveToPointEnabled="True" Margin="0,0,10,0"/>
                                
                        <TextBlock x:Name="TotalTimeText" Grid.Column="3" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <!-- Volume -->
                        <Slider x:Name="VolumeSlider" Grid.Column="4" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="1" 
                                ValueChanged="VolumeSlider_ValueChanged" Margin="0,0,15,0"/>
                                
                        <!-- Close -->
                        <Button Grid.Column="5" Content="✕ Close" Padding="10,5" Command="{Binding CloseViewerCommand}"
                                Background="#FF882222" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
