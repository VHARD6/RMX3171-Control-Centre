<UserControl x:Class="RMX3171ControlCentre.Views.DeviceInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Device Properties" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh Properties" Command="{Binding LoadPropertiesCommand}" Margin="20,0,0,0" Padding="15,6" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" VerticalAlignment="Center" IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
            <TextBlock Text="Loading..." Foreground="Orange" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
        </StackPanel>
        
        <DataGrid Grid.Row="1" ItemsSource="{Binding Properties}" AutoGenerateColumns="False" 
                  Background="{StaticResource CardBrush}" Foreground="Black" 
                  RowBackground="#FFEEEEEE" AlternatingRowBackground="White"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  HeadersVisibility="Column" IsReadOnly="True" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Property" Binding="{Binding Key}" Width="250"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
