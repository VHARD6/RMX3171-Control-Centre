<Window x:Class="RMX3171ControlCentre.Views.Dialogs.ModificationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modification Preview" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="You are about to modify the device:" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Operation:" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="OpText" Text="Disable" Foreground="#FF4EC9B0" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target:" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="TargetText" Text="com.example.app" Foreground="White"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Risk Classification:" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="RiskText" Text="MODIFY" Foreground="#FFDAA520" FontWeight="Bold"/>
                </Grid>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="State Change:" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="StateText" Text="Enabled -> Disabled" Foreground="White"/>
                </Grid>

                <TextBlock Text="Potential Consequences:" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                <TextBlock x:Name="ConsequencesText" Text="This may prevent the application and its associated services from running." 
                           TextWrapping="Wrap" Foreground="#FFD27272" Margin="0,0,0,20"/>

                <TextBlock Text="Exact ADB Command:" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                <Border Background="#FF1E1E1E" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
                    <TextBlock x:Name="CommandText" Text="adb shell pm disable-user --user 0 com.example.app" 
                               FontFamily="Consolas" Foreground="#FF569CD6" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Background="#FF3F3F46" Margin="0,0,10,0" Width="100"/>
            <Button Content="Execute" Click="Execute_Click" Background="#FFC23934" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
