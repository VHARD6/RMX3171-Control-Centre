<UserControl x:Class="RMX3171ControlCentre.Views.CapacityTesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="BATTERY DISCHARGE CAPACITY TEST" Style="{StaticResource HeaderLabel}" Margin="5,0,0,15"/>
                
                <Border Style="{StaticResource CardStyle}" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="EMPIRICAL DISCHARGE MEASUREMENT" Foreground="#FF007ACC" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Measures battery current over time to estimate delivered capacity. This is an empirical measurement, not an official battery-health reading." 
                                   TextWrapping="Wrap" Foreground="#FFCCCCCC" Margin="0,0,0,5"/>
                        <TextBlock Text="NOTE: This requires ADB-over-Wi-Fi. Establish a wireless ADB connection, then unplug the USB cable so the phone can discharge. The test will automatically pause if the device begins charging." 
                                   TextWrapping="Wrap" Foreground="#FFFFA500" FontStyle="Italic" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="Start percentage"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding StartPercentage, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,5,0" IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="Stop percentage"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding StopPercentage, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,5,0" IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Start Test" Command="{Binding StartTestCommand}" Padding="15,5" Margin="0,0,10,0"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                            <Button Content="Stop Test" Command="{Binding StopTestCommand}" Padding="15,5"
                                    IsEnabled="{Binding IsRunning}"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding StatusText}" Foreground="Orange" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ErrorText}" Foreground="Red"/>
                    </StackPanel>
                </Border>

                <!-- Current telemetry during test -->
                <Border Style="{StaticResource CardStyle}" MaxWidth="600" HorizontalAlignment="Left" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="LIVE TELEMETRY" Style="{StaticResource HeaderLabel}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="Current"/>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding CurrentDraw}"/>
                                
                                <TextBlock Style="{StaticResource Label}" Text="Voltage"/>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding Voltage}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="Temperature"/>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding Temperature}"/>
                                
                                <TextBlock Style="{StaticResource Label}" Text="Battery"/>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding BatteryLevel}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Estimated discharged"/>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding EstimatedDischarged}" Foreground="LimeGreen"/>
                                
                                <TextBlock Style="{StaticResource Label}" Text="Elapsed"/>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding ElapsedTime}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Results card -->
                <Border Style="{StaticResource CardStyle}" MaxWidth="600" HorizontalAlignment="Left" Margin="0,15,0,0"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="EMPIRICAL RESULT" Style="{StaticResource HeaderLabel}" Foreground="Cyan"/>
                        
                        <TextBlock Style="{StaticResource Label}" Text="Estimated delivered capacity (extrapolated 100%)"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding EmpiricalResult}" FontSize="24" Foreground="Cyan"/>
                        
                        <TextBlock Style="{StaticResource Label}" Text="Rated capacity"/>
                        <TextBlock Style="{StaticResource Value}" Text="6,000 mAh"/>
                        
                        <TextBlock Style="{StaticResource Label}" Text="Approx. rated-capacity ratio"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding RatedRatio}"/>
                        
                        <TextBlock Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0">
                            Measurement uncertainty: ±5-10%. This is based on real-time current integration (trapezoidal/rectangular) over time. True capacity depends heavily on temperature, workload, and discharge rate. It is highly recommended to run multiple tests in the 80% → 20% range and average the results.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Data log -->
                <Border Style="{StaticResource CardStyle}" MaxWidth="780" HorizontalAlignment="Left" Margin="0,15,0,20">
                    <StackPanel>
                        <TextBlock Text="TELEMETRY LOG (Samples every ~15s)" Style="{StaticResource HeaderLabel}"/>
                        <DataGrid ItemsSource="{Binding LogEntries}" AutoGenerateColumns="False"
                                  Background="#FF2D2D30" RowBackground="#FF252525" AlternatingRowBackground="#FF2A2A2A"
                                  Foreground="White" MaxHeight="300"
                                  HeadersVisibility="Column" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                                <DataGridTextColumn Header="Level %" Binding="{Binding Level}"/>
                                <DataGridTextColumn Header="Current (mA)" Binding="{Binding CurrentMa}"/>
                                <DataGridTextColumn Header="Voltage (V)" Binding="{Binding VoltageV}"/>
                                <DataGridTextColumn Header="Temp (°C)" Binding="{Binding TempC}"/>
                                <DataGridTextColumn Header="Accum. mAh" Binding="{Binding AccumulatedMah}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
