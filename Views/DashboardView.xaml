<UserControl x:Class="RMX3171ControlCentre.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Refresh Device" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
            <Button Content="Restart ADB" Command="{Binding RestartAdbCommand}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1">
            <Border Style="{StaticResource CardStyle}" Width="300" Height="250">
                <StackPanel>
                    <TextBlock Text="Device Details" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model: " Margin="0,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model}" Margin="10,5" Foreground="White"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Android: " Margin="0,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AndroidVersion}" Margin="10,5" Foreground="White"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SoC: " Margin="0,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Soc}" Margin="10,5" Foreground="White"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Serial: " Margin="0,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                            <TextBlock Text="{Binding DisplaySerialNumber}" Foreground="White" VerticalAlignment="Center" FontFamily="Consolas"/>
                            <Button Command="{Binding ToggleSerialCommand}" Padding="5,2" Margin="10,0,0,0" Background="#FF333333">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="Hide"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSerialHidden}" Value="True">
                                                <Setter Property="Content" Value="Show"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource CardStyle}" Width="450">
                <StackPanel>
                    <TextBlock Text="Wireless ADB (Android 11+)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="1. Enable Developer Options &amp; Wireless Debugging.&#10;2. Pair device with port &amp; code shown on phone.&#10;3. Connect using the persistent IP &amp; port (often 5555)." 
                               TextWrapping="Wrap" Foreground="#FFCCCCCC" Margin="0,0,0,15" FontSize="12"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="IP:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding WirelessIp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        
                        <TextBlock Grid.Column="2" Text="Pair Port:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="3" Text="{Binding PairingPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        
                        <TextBlock Grid.Column="4" Text="Code:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="5" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    
                    <Button Content="Pair Device" Command="{Binding PairWirelessCommand}" Margin="0,0,0,15" Padding="5"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection Port (default 5555):" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding ConnectionPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Connect" Command="{Binding ConnectWirelessCommand}" Margin="0,0,10,0" Padding="15,5"/>
                        <Button Content="Disconnect All" Command="{Binding DisconnectWirelessCommand}" Padding="15,5" Background="#FF442222"/>
                    </StackPanel>

                    <TextBlock Text="{Binding WirelessMessage}" Foreground="{Binding WirelessMessageColor}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </WrapPanel>
    </Grid>
</UserControl>
