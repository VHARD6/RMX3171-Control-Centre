<UserControl x:Class="RMX3171ControlCentre.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Dashboard Overview" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Refresh Now" Command="{Binding RefreshCommand}" Margin="20,0,0,0" Padding="15,6" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" VerticalAlignment="Center" IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
                <TextBlock Text="Refreshing..." Foreground="Orange" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <TextBlock Text="{Binding LastUpdatedText}" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            
            <UniformGrid Columns="2" Rows="2">
                <!-- Device -->
                <Border Style="{StaticResource CardStyle}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="DEVICE" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding DeviceInfoText}" Foreground="White" FontSize="18"/>
                    </StackPanel>
                </Border>
                
                <!-- Battery -->
                <Border Style="{StaticResource CardStyle}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="BATTERY" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding BatteryText}" Foreground="White" FontSize="18"/>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Style="{StaticResource CardStyle}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding MemoryText}" Foreground="White" FontSize="18"/>
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Style="{StaticResource CardStyle}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="STORAGE (User Data)" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding StorageText}" Foreground="White" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            
            <Border Style="{StaticResource CardStyle}" Width="450" HorizontalAlignment="Left" Margin="10,20,0,0">
                <StackPanel>
                    <TextBlock Text="Wireless ADB (Android 11+)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="1. Enable Developer Options &amp; Wireless Debugging.&#10;2. Pair device with port &amp; code shown on phone.&#10;3. Connect using the persistent IP &amp; port (often 5555)." 
                               TextWrapping="Wrap" Foreground="#FFCCCCCC" Margin="0,0,0,15" FontSize="12"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="IP:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding WirelessIp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        
                        <TextBlock Grid.Column="2" Text="Pair Port:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="3" Text="{Binding PairingPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        
                        <TextBlock Grid.Column="4" Text="Code:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="5" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    
                    <Button Content="Pair Device" Command="{Binding PairWirelessCommand}" Margin="0,0,0,15" Padding="5"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="IP:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding WirelessIp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        
                        <TextBlock Grid.Column="2" Text="Conn Port:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="3" Text="{Binding ConnectionPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Connect" Command="{Binding ConnectWirelessCommand}" Padding="15,5" Margin="0,0,10,0"/>
                        <Button Content="Disconnect All" Command="{Binding DisconnectWirelessCommand}" Padding="15,5" Background="#FF333333"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding WirelessMessage}" Foreground="{Binding WirelessMessageColor}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
