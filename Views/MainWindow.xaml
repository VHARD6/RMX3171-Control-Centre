<Window x:Class="RMX3171ControlCentre.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RMX3171ControlCentre.Views"
        xmlns:viewmodels="clr-namespace:RMX3171ControlCentre.ViewModels"
        Title="RMX3171 Control Centre" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DeviceInfoViewModel}">
            <views:DeviceInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:StorageViewModel}">
            <views:StorageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BatteryViewModel}">
            <views:BatteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CapacityTesterViewModel}">
            <views:CapacityTesterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MemoryManagerViewModel}">
            <views:MemoryManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AppManagerViewModel}">
            <views:AppManagerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="RMX3171 Control" Foreground="White" FontSize="18" FontWeight="Bold" Margin="15,0,0,20"/>
                
                <StackPanel Orientation="Horizontal" Margin="15,0,0,10">
                    <Ellipse Width="12" Height="12" Fill="{Binding ConnectionColor}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="15,0,0,20">
                    <TextBlock Text="{Binding ModeText}" Foreground="{Binding ModeColor}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Margin="10,5" HorizontalAlignment="Stretch"/>
                <Button Content="Device Info" Command="{Binding NavigateCommand}" CommandParameter="Device" Margin="10,5" HorizontalAlignment="Stretch"/>
                <Button Content="Storage" Command="{Binding NavigateCommand}" CommandParameter="Storage" Margin="10,5" HorizontalAlignment="Stretch"/>
                <Button Content="Battery" Command="{Binding NavigateCommand}" CommandParameter="Battery" Margin="10,5" HorizontalAlignment="Stretch"/>
                <Button Content="Discharge Test" Command="{Binding NavigateCommand}" CommandParameter="Capacity" Margin="10,5" HorizontalAlignment="Stretch"/>
                <Button Content="Task Manager" Command="{Binding NavigateCommand}" CommandParameter="Memory" Margin="10,5" HorizontalAlignment="Stretch"/>
                <Button Content="App Manager" Command="{Binding NavigateCommand}" CommandParameter="AppManager" Margin="10,5" HorizontalAlignment="Stretch"/>
                <Button Content="Logs" Command="{Binding NavigateCommand}" CommandParameter="Logs" Margin="10,5" HorizontalAlignment="Stretch"/>
                
                <Border BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0" Margin="10,20,10,10" />
                
                <Button Command="{Binding ToggleModeCommand}" Margin="10,5" HorizontalAlignment="Stretch" Background="#FF333333">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Enter Advanced Mode" />
                            <Setter Property="Foreground" Value="Orange" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdvancedMode}" Value="True">
                                    <Setter Property="Content" Value="Exit Advanced Mode" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="10"/>
    </Grid>
</Window>
