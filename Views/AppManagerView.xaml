<UserControl x:Class="RMX3171ControlCentre.Views.AppManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Application Manager" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Scan Packages" Command="{Binding RefreshCommand}" Margin="20,0,0,0" Padding="15,6" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" VerticalAlignment="Center" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
            <TextBlock Text="Scanning..." Foreground="Orange" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
        </StackPanel>
        
        <!-- Search and Filters -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Search:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#FF1E1E1E" Foreground="White" BorderThickness="1" BorderBrush="#FF333337" Padding="5"/>
                <TextBlock Grid.Column="2" Text="Filter:" Foreground="White" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                          Background="#FF1E1E1E" Foreground="White" BorderThickness="1" BorderBrush="#FF333337" Padding="5"/>
                          
                <Button Grid.Column="5" Content="Build Action Plan" Command="{Binding BuildActionPlanCommand}" 
                        Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="15,6" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding FilteredPackages}" SelectedItem="{Binding SelectedApp}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#262629" GridLinesVisibility="None"
                          Foreground="White" SelectionMode="Single" HorizontalAlignment="Stretch">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#333337"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#444448"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF007ACC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelectedForAction, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Package Name" Binding="{Binding PackageName}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding RiskLevelString}" Width="100"/>
                        <DataGridTextColumn Header="State" Binding="{Binding IsEnabled, Converter={StaticResource BoolToStateConverter}}" Width="80"/>
                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamMb, StringFormat={}{0:F1}}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Details Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock Text="Select an application to view details and available actions." 
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding IsAppSelected, Converter={StaticResource InverseBooleanConverter}}"/>
                               
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAppSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="APPLICATION DETAILS" FontSize="13" FontWeight="Bold" Foreground="#FF888888" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="Application" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding SelectedApp.AppName}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <TextBlock Text="Package" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding SelectedApp.PackageName}" Foreground="White" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            
                            <TextBlock Text="Type (Risk Level)" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding SelectedApp.RiskLevelString}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="State" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding SelectedApp.IsEnabled, Converter={StaticResource BoolToStateConverter}}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="RAM Usage" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding SelectedApp.RamMb, StringFormat={}{0:F1} MB}" Foreground="White" FontSize="14" Margin="0,0,0,20"/>
                            
                            <Border BorderBrush="#FF333337" BorderThickness="0,1,0,0" Margin="0,0,0,20"/>

                            <TextBlock Text="ACTIONS" FontSize="13" FontWeight="Bold" Foreground="#FF888888" Margin="0,0,0,12"/>
                            
                            <Button Content="Force Stop" Command="{Binding ForceStopCommand}" CommandParameter="{Binding SelectedApp}" Margin="0,0,0,10" Padding="10,8" Background="#FF444448"/>
                            <Button Content="Disable App" Command="{Binding DisableAppCommand}" CommandParameter="{Binding SelectedApp}" Margin="0,0,0,10" Padding="10,8" Background="#FFC23934" Visibility="{Binding SelectedApp.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="Enable App" Command="{Binding EnableAppCommand}" CommandParameter="{Binding SelectedApp}" Margin="0,0,0,10" Padding="10,8" Background="#FF4EC9B0" Foreground="Black">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp.IsEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Border BorderBrush="#FF333337" BorderThickness="0,1,0,0" Margin="0,10,0,20"/>
                            
                            <Button Content="Uninstall for User" Command="{Binding UninstallUserCommand}" CommandParameter="{Binding SelectedApp}" Margin="0,0,0,10" Padding="10,8" Background="#FF800000"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
