<UserControl x:Class="RMX3171ControlCentre.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localViewModels="clr-namespace:RMX3171ControlCentre.ViewModels.Storage"
             xmlns:localViews="clr-namespace:RMX3171ControlCentre.Views.Storage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate DataType="{x:Type localViewModels:AppStorageViewModel}">
            <localViews:AppStorageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type localViewModels:PhotosStorageViewModel}">
            <localViews:PhotosStorageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type localViewModels:VideosStorageViewModel}">
            <localViews:VideosStorageView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Refresh Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Storage Overview" Foreground="White" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastUpdatedText}" Foreground="#FF888888" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Refreshing..." Foreground="Orange" VerticalAlignment="Center" Margin="0,0,15,0"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <Button Content="Refresh Now" Command="{Binding RefreshStorageCommand}" Padding="16,8"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
            </StackPanel>
        </Grid>

        <!-- Content Area: Hub -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" 
                      Visibility="{Binding IsHubVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">

                <!-- Loading State Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="10,25" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,0,0,15"
                                     Foreground="{StaticResource PrimaryBrush}" Background="#FF333333" BorderThickness="0"/>
                        <TextBlock Text="{Binding LoadingStatusText}" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Unavailable State Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"
                        Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="10,25" HorizontalAlignment="Center">
                        <TextBlock Text="USER-DATA STORAGE" FontSize="14" FontWeight="Bold" Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding LoadingStatusText}" Foreground="#FFAAAAAA" FontSize="15" HorizontalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="Retry" Command="{Binding RefreshStorageCommand}" Margin="0,15,0,0" Padding="16,6"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Main Storage Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"
                        Visibility="{Binding IsLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <!-- Card Title & Status Badge -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="USER-DATA STORAGE" FontSize="14" FontWeight="Bold" Foreground="#FF888888" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HealthIndicatorText}" Foreground="{Binding HealthIndicatorColor}" 
                                       HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Large Summary: XX.X GB / XX.X GB used -->
                        <TextBlock Text="{Binding InternalSummary}" FontSize="32" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,15"/>

                        <!-- Storage Progress Bar -->
                        <ProgressBar Value="{Binding UsagePercent}" Minimum="0" Maximum="100" Height="22" Margin="0,0,0,20"
                                     Foreground="{StaticResource PrimaryBrush}" Background="#FF333333" BorderThickness="0"/>

                        <!-- Details Row: Total, Used, Free, Usage -->
                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total:" Foreground="#FF888888" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalGbText}" Foreground="White" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Used:" Foreground="#FF888888" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UsedGbText}" Foreground="White" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Free:" Foreground="#FF888888" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding FreeGbText}" Foreground="White" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Usage:" Foreground="#FF888888" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UsagePercentText}" Foreground="White" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Categories -->
                <Grid Visibility="{Binding IsLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding NavigateToAppsCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch" Background="#FF2D2D30">
                            <StackPanel VerticalAlignment="Center" Margin="10">
                                <TextBlock Text="Apps" FontSize="14" FontWeight="Bold" Foreground="#FF888888"/>
                                <TextBlock Text="{Binding AppStorageTotalText}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding NavigateToPhotosCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch" Background="#FF2D2D30">
                            <StackPanel VerticalAlignment="Center" Margin="10">
                                <TextBlock Text="Photos" FontSize="14" FontWeight="Bold" Foreground="#FF888888"/>
                                <TextBlock Text="{Binding PhotoStorageTotalText}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Grid.Column="4" Command="{Binding NavigateToVideosCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch" Background="#FF2D2D30">
                            <StackPanel VerticalAlignment="Center" Margin="10">
                                <TextBlock Text="Videos" FontSize="14" FontWeight="Bold" Foreground="#FF888888"/>
                                <TextBlock Text="{Binding VideoStorageTotalText}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- SUB-PAGE CONTENT CONTROL -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" 
                        Visibility="{Binding IsHubVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
