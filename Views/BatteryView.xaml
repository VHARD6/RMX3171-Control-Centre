<UserControl x:Class="RMX3171ControlCentre.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Tooltip-style help label -->
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Battery Status" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh Now" Command="{Binding RefreshBatteryCommand}" Margin="20,0,0,0" Padding="15,6" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" VerticalAlignment="Center" IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
            <TextBlock Text="Refreshing..." Foreground="Orange" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
            <TextBlock Text="{Binding LastUpdatedText}" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══════════ BATTERY MAIN CARD ═══════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" MaxWidth="520" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: details -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BATTERY" FontSize="13" FontWeight="Bold"
                                       Foreground="#FF888888" Margin="0,0,0,12"/>

                            <TextBlock Style="{StaticResource Label}" Text="Status"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ChargingSource}"/>

                            <TextBlock Style="{StaticResource Label}" Text="Temperature"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Temperature}"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Battery temperature reported by Android. Value from dumpsys battery."/>

                            <TextBlock Style="{StaticResource Label}" Text="Voltage"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Voltage}"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Battery voltage reported by Android (in mV, displayed as V)."/>

                            <TextBlock Style="{StaticResource Label}" Text="Technology"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Technology}"/>

                            <TextBlock Style="{StaticResource Label}" Text="Fast charging"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding FastCharging}"/>
                        </StackPanel>

                        <!-- Right: big % circle -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="110" Height="110" Stroke="#FF007ACC" StrokeThickness="8" Fill="#FF252526"/>
                            <TextBlock Text="🔋" FontSize="22" HorizontalAlignment="Center" Margin="0,-90,0,0"/>
                            <TextBlock Text="{Binding BatteryLevelText}" FontSize="26" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════ HEALTH CARD ══════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="BATTERY HEALTH" FontSize="13" FontWeight="Bold"
                                   Foreground="#FF888888" Margin="0,0,0,12"/>

                        <!-- OS health status -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="OrangeRed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthIsGood}" Value="True">
                                                <Setter Property="Fill" Value="LimeGreen"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       Text="{Binding HealthStatus}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="OS-reported health status — this is Android's assessment of battery condition. It is NOT the same as remaining capacity."/>

                        <!-- Capacity health -->
                        <TextBlock Style="{StaticResource Label}" Text="Capacity health"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding CapacityHealth}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Calculated from /sys/class/power_supply/battery/charge_full ÷ charge_full_design. Only shown if both values are available."/>

                        <!-- Cycle count -->
                        <TextBlock Style="{StaticResource Label}" Text="Cycle count"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding CycleCount}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="From /sys/class/power_supply/battery/cycle_count. Not all Android 11 devices expose this value."/>

                        <!-- Summary -->
                        <Border Background="#FF1E1E1E" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                            <TextBlock Text="{Binding HealthSummaryText}" Foreground="#FFCCCCCC"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════ CHARGING SECTION ═════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="CHARGING" FontSize="13" FontWeight="Bold"
                                   Foreground="#FF888888" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource Label}" Text="Charge counter (current)"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding ChargeCounter}"/>
                        <TextBlock Style="{StaticResource HelpText}" Text="{Binding ChargeCounterNote}"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════ ADVANCED TOGGLE ═══════════════════════════════ -->
                <Button Content="Advanced Battery Information ▼"
                        Command="{Binding ToggleAdvancedCommand}"
                        HorizontalAlignment="Left" Margin="5,12,0,8"
                        Background="Transparent" Foreground="#FF007ACC"/>

                <!-- ═══════════ ADVANCED PANEL ════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch"
                        Visibility="{Binding IsAdvancedVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Complete battery property table — all values directly from ADB output."
                                   Foreground="#FF888888" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <DataGrid ItemsSource="{Binding AdvancedRows}" AutoGenerateColumns="False"
                                  Background="#FF2D2D30" RowBackground="#FF252525" AlternatingRowBackground="#FF2A2A2A"
                                  Foreground="White" Margin="0,0,0,15"
                                  HeadersVisibility="Column" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FF3F3F3F">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FF333333"/>
                                    <Setter Property="Foreground" Value="#FFAAAAAA"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="200"/>
                                <DataGridTextColumn Header="Value"    Binding="{Binding Value}"    Width="120"/>
                                <DataGridTextColumn Header="Unit"     Binding="{Binding Unit}"     Width="80"/>
                                <DataGridTextColumn Header="Meaning"  Binding="{Binding Meaning}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- /sys readings -->
                        <TextBlock Text="Linux power_supply class (/sys/class/power_supply/battery/):"
                                   Foreground="#FF888888" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RawSysPowerSupply}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="#FFCCCCCC" Background="#FF1A1A1A"
                                 BorderThickness="1" BorderBrush="#FF3F3F3F"
                                 TextWrapping="Wrap" Padding="8" Margin="0,0,0,12"/>

                        <!-- dumpsys raw -->
                        <TextBlock Text="Raw: adb shell dumpsys battery"
                                   Foreground="#FF888888" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RawDumpsysBattery}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="#FFCCCCCC" Background="#FF1A1A1A"
                                 BorderThickness="1" BorderBrush="#FF3F3F3F"
                                 TextWrapping="Wrap" Padding="8"
                                 MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="8,10,0,20" Foreground="#FF555555" FontSize="11"
                           Text="All battery information is read-only. No modifications are made to the device."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
